# UTN Assistant — API image
# Builds a single image used for both the API service and the one-shot workers.
#
# Build context: utn-assistant/  (one level above this file)
# Run:  uvicorn api.main:app --host 0.0.0.0 --port 8000

# ---------------------------------------------------------------------------
# Stage 1: dependency installer
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build

# System packages needed to compile lxml / chromadb native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file first (better layer cache)
COPY requirements.txt ./

# Install torch CPU-only first to avoid pulling CUDA (~2.5 GB) unnecessarily
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --prefix=/install \
        torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: Playwright browser installer
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS playwright-base

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# System runtime libraries required by Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Playwright Chromium runtime deps
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libatspi2.0-0 \
    libx11-6 \
    libxext6 \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install only Chromium (skip Firefox/WebKit to keep the image small)
RUN playwright install chromium

# ---------------------------------------------------------------------------
# Stage 3: final runtime image
# ---------------------------------------------------------------------------
FROM playwright-base AS final

# Non-root user for security
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Copy application source (context = utn-assistant/)
COPY --chown=appuser:appuser api/         ./api/
COPY --chown=appuser:appuser config/      ./config/
COPY --chown=appuser:appuser processor/   ./processor/
COPY --chown=appuser:appuser rag/         ./rag/
COPY --chown=appuser:appuser scraper/     ./scraper/
COPY --chown=appuser:appuser vectorstore/ ./vectorstore/
COPY --chown=appuser:appuser pyproject.toml ./

# Directory for ChromaDB data (overridden by volume mount at runtime)
RUN mkdir -p /data/chromadb && chown appuser:appuser /data/chromadb

USER appuser

# Expose API port
EXPOSE 8000

# Default: run the FastAPI service
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
