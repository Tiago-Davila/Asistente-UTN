# Docker build context exclusions for utn-assistant images

# Version control
.git/
.gitignore

# Python caches
__pycache__/
*.py[cod]
*.pyo
*.so

# Virtual environments
.venv/
venv/
env/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Local data (mounted as volumes at runtime)
data/

# Environment secrets
.env
.env.*
!.env.example

# Docs & planning artefacts (not needed in image)
specs/
*.md
!utn-assistant/infra/README.md

# IDE
.vscode/
.idea/

# Logs
*.log
logs/
