# UTN Assistant — Local environment template
# Copy this file to .env and fill in the values before running the service.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Source configuration
# ---------------------------------------------------------------------------
# Path to the YAML file that lists configured UTN institutional sources.
SOURCES_CONFIG_PATH=./config/sources.yaml

# ---------------------------------------------------------------------------
# ChromaDB persistence
# ---------------------------------------------------------------------------
# Directory where ChromaDB stores its persistent data.
CHROMADB_PATH=./data/chromadb

# ---------------------------------------------------------------------------
# Ollama / LLM
# ---------------------------------------------------------------------------
# Base URL for the Ollama-compatible OpenAI endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chat/generation model to use for answer synthesis.
LLM_MODEL=llama3

# Embedding model name for sentence-transformers.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ---------------------------------------------------------------------------
# RAG retrieval settings
# ---------------------------------------------------------------------------
# Global cosine-similarity relevance threshold (0–1).
# Queries where no fragment meets this threshold will return the refusal text.
RELEVANCE_THRESHOLD=0.65

# Maximum number of fragments to retrieve per query (1–10).
TOP_K=5

# ---------------------------------------------------------------------------
# Chunking settings
# ---------------------------------------------------------------------------
# Target chunk size in text units (tokens / characters).
CHUNK_SIZE=800

# Overlap between consecutive chunks.
CHUNK_OVERLAP=120

# ---------------------------------------------------------------------------
# Scraper settings
# ---------------------------------------------------------------------------
# Delay between HTTP requests to the same domain, in seconds.
REQUEST_DELAY_SECONDS=1.0

# HTTP timeout for fetching a single source page, in seconds.
SOURCE_FETCH_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Query settings
# ---------------------------------------------------------------------------
# Maximum allowed question length in characters.
MAX_QUESTION_LENGTH=2000

# Hard generation timeout, in seconds.
# Queries that exceed this return a controlled error.
GENERATION_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
